<Project Sdk="Microsoft.NET.Sdk">

	<!-- Tests for c2flux.Core. Plain net10.0: CI runs them on Windows, macOS
	     and Linux. -->

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<RootNamespace>c2flux.Core.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\c2flux.Core\c2flux.Core.csproj" />
	</ItemGroup>

	<!-- Stand-ins for the languages shipped next to the executable. -->
	<ItemGroup>
		<None Include="Languages\*.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
