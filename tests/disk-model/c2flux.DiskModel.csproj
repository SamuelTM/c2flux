<Project Sdk="Microsoft.NET.Sdk">

	<!-- Runs the duplicate analysis once over a folder, for run.py. Not in the
	     solution: Linux only, built per version under test. The assembly name
	     is the one c2flux.Core shows its internals to, in every version. -->

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<AssemblyName>c2flux.Core.Tests</AssemblyName>
		<RootNamespace>c2flux.DiskModel</RootNamespace>
		<NoWarn>$(NoWarn);CA1416</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\c2flux.Core\c2flux.Core.csproj" />
		<ProjectReference Include="..\..\src\c2flux.Platform.Linux\c2flux.Platform.Linux.csproj" />
	</ItemGroup>

</Project>
