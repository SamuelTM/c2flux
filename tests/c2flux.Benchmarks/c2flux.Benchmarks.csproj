<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Command-line tool that runs a single c2flux scanner once and prints the
		measurements as JSON. It does not reference c2flux at compile time: the
		app is loaded by reflection from a build directory (see AppLoader.cs), so
		one build of this tool can measure any c2flux version, including the
		baseline-winforms tag.
	-->

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<AssemblyName>c2flux-bench</AssemblyName>
		<RootNamespace>c2flux.Benchmarks</RootNamespace>
	</PropertyGroup>

	<!-- On Windows the tool also loads the Windows Desktop runtime, which the
	     WinForms app assembly references, and runs as x64 because the app is
	     built for win-x64 (an x64 assembly cannot load into an ARM64 process).
	     Elsewhere it builds as plain net10.0 so the loading code can be
	     exercised locally against an AnyCPU build of the app. -->
	<PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
	</PropertyGroup>

	<PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

</Project>
