<Project Sdk="Microsoft.NET.Sdk">

	<!--
		The cross-platform UI (Avalonia). Replaces c2flux.WinForms; until it is
		complete (ROADMAP.md, phase 5) both exist side by side.
	-->

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<AssemblyName>c2flux.App</AssemblyName>
		<RootNamespace>c2flux</RootNamespace>
		<ApplicationIcon>..\c2flux.WinForms\Ressources\c2flux.ico</ApplicationIcon>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<!-- Platform projects are picked at runtime by OperatingSystem checks. -->
		<NoWarn>$(NoWarn);CA1416</NoWarn>

		<Authors>Daniel Capilla</Authors>
		<Company>Daniel Capilla</Company>
		<Product>c² flux - Tree Scanner</Product>
		<Copyright>Copyright © Daniel Capilla</Copyright>

		<Version>1.4.1</Version>
		<AssemblyVersion>1.4.1</AssemblyVersion>
		<FileVersion>1.4.1</FileVersion>
		<InformationalVersion>1.4.1</InformationalVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.3" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
		<PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.3" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\c2flux.Core\c2flux.Core.csproj" />
		<ProjectReference Include="..\c2flux.Platform.Windows\c2flux.Platform.Windows.csproj" />
		<ProjectReference Include="..\c2flux.Platform.MacOS\c2flux.Platform.MacOS.csproj" />
		<ProjectReference Include="..\c2flux.Platform.Linux\c2flux.Platform.Linux.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="c2flux.App.Tests" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\Fonts\*.ttf" />
		<None Include="Assets\Fonts\Selawik-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- Shared with the WinForms app until phase 7 removes it. -->
	<ItemGroup>
		<AvaloniaResource Include="..\c2flux.WinForms\Ressources\c2flux.png" Link="Assets\c2flux.png" />
		<AvaloniaResource Include="..\c2flux.WinForms\Ressources\molotov.jpg" Link="Assets\molotov.jpg" />
		<AvaloniaResource Include="..\c2flux.WinForms\Ressources\ko-fi.png" Link="Assets\ko-fi.png" />
		<AvaloniaResource Include="..\c2flux.WinForms\Ressources\scan-history-details.png" Link="Assets\scan-history-details.png" />
		<None Include="..\c2flux.WinForms\Ressources\Languages\lang_*.json"
		      Exclude="..\c2flux.WinForms\Ressources\Languages\lang_de.json;..\c2flux.WinForms\Ressources\Languages\lang_en.json"
		      Link="Languages\%(Filename)%(Extension)"
		      CopyToOutputDirectory="PreserveNewest"
		      CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
