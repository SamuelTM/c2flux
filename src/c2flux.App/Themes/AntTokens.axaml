<!--
  Colors of the WinForms theme (AntdThemeService.cs). Light values replace
  the Windows SystemColors the WinForms light mode used (Window, Control,
  ControlLight, ControlText, ControlDark) with their default values.
  Shapes follow Ant Design: 6 px controls, 8 px popups.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="#F0F0F0" />
      <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="#E3E3E3" />
      <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#F0F0F0" />
      <SolidColorBrush x:Key="SurfaceHighlightBrush" Color="#A0A0A0" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#000000" />
      <SolidColorBrush x:Key="DisabledTextBrush" Color="#000000" />
      <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BorderBrush" Color="#D9D9D9" />
      <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#F5F5F5" />
      <SolidColorBrush x:Key="PressedBackgroundBrush" Color="#E6F4FF" />
      <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
      <SolidColorBrush x:Key="IconInactiveBrush" Color="#005499" />
      <SolidColorBrush x:Key="UsageBarTrackBrush" Color="#E1E1E1" />
      <SolidColorBrush x:Key="UsageBarFillBrush" Color="#1677FF" />
      <SolidColorBrush x:Key="TableProgressBackBrush" Color="#E6E6E6" />
      <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D9D9D9" />
      <SolidColorBrush x:Key="ButtonDisabledBackgroundBrush" Color="#0A000000" />
      <SolidColorBrush x:Key="PrimaryBrush" Color="#1677FF" />
      <SolidColorBrush x:Key="SelectBorderBrush" Color="#A0A0A0" />
      <SolidColorBrush x:Key="GridLineBrush" Color="#C8C8C8" />
      <SolidColorBrush x:Key="TableProgressFillBrush" Color="#5A8CD2" />
      <!-- Ant Design button shadows (0 2px 0). -->
      <BoxShadows x:Key="ButtonShadow">0 2 0 0 #05000000</BoxShadows>
      <BoxShadows x:Key="PrimaryButtonShadow">0 2 0 0 #1A0591FF</BoxShadows>
      <BoxShadows x:Key="InputFocusShadow">0 0 0 4 #1A0591FF</BoxShadows>
      <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#1677FF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="#202020" />
      <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="#2D2D2D" />
      <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="#373737" />
      <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#181818" />
      <SolidColorBrush x:Key="SurfaceHighlightBrush" Color="#505050" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DisabledTextBrush" Color="#808080" />
      <SolidColorBrush x:Key="InputBackgroundBrush" Color="#262626" />
      <SolidColorBrush x:Key="BorderBrush" Color="#444444" />
      <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#3A3A3A" />
      <SolidColorBrush x:Key="PressedBackgroundBrush" Color="#484848" />
      <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
      <SolidColorBrush x:Key="IconInactiveBrush" Color="#5CA9FF" />
      <SolidColorBrush x:Key="UsageBarTrackBrush" Color="#404040" />
      <SolidColorBrush x:Key="UsageBarFillBrush" Color="#4B91E6" />
      <SolidColorBrush x:Key="TableProgressBackBrush" Color="#3A3A3A" />
      <!-- Ant Design dark component tokens, as measured in the WinForms toolbar. -->
      <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#141414" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#424242" />
      <SolidColorBrush x:Key="ButtonDisabledBackgroundBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="PrimaryBrush" Color="#1668DC" />
      <SolidColorBrush x:Key="SelectBorderBrush" Color="#505050" />
      <!-- ControlPaint.Dark(BackgroundSecondary, 0.2), measured. -->
      <SolidColorBrush x:Key="GridLineBrush" Color="#181818" />
      <SolidColorBrush x:Key="TableProgressFillBrush" Color="#4687DC" />
      <!-- Measured: white at 4 %, primary at 14 % and 12 %. -->
      <BoxShadows x:Key="ButtonShadow">0 2 0 0 #0AFFFFFF</BoxShadows>
      <BoxShadows x:Key="PrimaryButtonShadow">0 2 0 0 #241668DC</BoxShadows>
      <BoxShadows x:Key="InputFocusShadow">0 0 0 4 #1F1668DC</BoxShadows>
      <!-- Measured: 2 px of primary at 50 %. -->
      <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#801668DC" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
  <!-- Segoe UI 9 pt (SystemFonts.MessageBoxFont) is 12 px at 100 %;
       Selawik has its metrics (see AppFonts). -->
  <FontFamily x:Key="ContentControlThemeFontFamily">avares://c2flux.App/Assets/Fonts#Selawik</FontFamily>
  <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
</ResourceDictionary>
