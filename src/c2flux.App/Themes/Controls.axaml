<!--
  Control styles of the WinForms toolbar and panels (AntdUI buttons,
  selects and panels), applied with style classes so other windows keep
  the Fluent defaults until they are ported.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- AntdUI.Button in the main toolbar: 32 px high, radius 6. -->
  <Style Selector="Button.ant, ToggleButton.ant">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ant:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.ant:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource IconInactiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource IconInactiveBrush}" />
  </Style>
  <Style Selector="Button.ant:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.ant:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PressedBackgroundBrush}" />
  </Style>
  <Style Selector="Button.ant:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.ant:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonDisabledBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
  </Style>
  <!-- Toggle on: AntdUI ToggleType Primary. -->
  <Style Selector="ToggleButton.ant:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- AntdUI.Button Type = Primary (dialog default buttons). -->
  <Style Selector="Button.ant.primary">
    <Setter Property="Height" Value="32" />
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.ant.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconInactiveBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource IconInactiveBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- AntdUI.Button in dialogs: the body leaves the 4 px wave margin of
       the bounds free, no border, a 2 px shadow below. -->
  <Style Selector="Button.ant.dialog">
    <Setter Property="BorderThickness" Value="0" />
    <!-- The inset is a Border padding: a margin on the presenter itself
         breaks its content alignment (it sizes content by its DesiredSize,
         margin included). -->
    <Setter Property="Template">
      <ControlTemplate>
        <Border Padding="4">
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            RecognizesAccessKey="True"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.ant.dialog /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource ButtonShadow}" />
  </Style>
  <Style Selector="Button.ant.dialog.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource PrimaryButtonShadow}" />
  </Style>

  <!-- AntdUI.Input: like the dialog buttons, 4 px wave margin; the focus
       ring fills it. -->
  <Style Selector="TextBox.ant">
    <Setter Property="MinHeight" Value="0" />
    <!-- 7 px inside the border, which is 4 px in. -->
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBox.ant /template/ Border#PART_BorderElement, TextBox.ant:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Margin" Value="4" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
  </Style>
  <Style Selector="TextBox.ant:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource ButtonDisabledBackgroundBrush}" />
  </Style>
  <Style Selector="TextBox.ant:disabled">
    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
  </Style>
  <Style Selector="TextBox.ant:focus /template/ Border#PART_BorderElement">
    <Setter Property="Margin" Value="4" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource InputFocusShadow}" />
  </Style>

  <!-- AntdUI.Button with a border (the Filters button of the search). -->
  <Style Selector="Button.ant.dialog.bordered">
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
  </Style>

  <!-- The search button: AntdUI primary with BackgroundSecondary as color. -->
  <Style Selector="Button.ant.dialog.secondary">
    <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}" />
  </Style>

  <!-- Round AntdUI buttons (the + and - of the language list, the ? of
       help): a 1 px border, fully rounded. -->
  <Style Selector="Button.ant.dialog.round">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Button.ant.dialog.primary.round">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- AntdUI.Checkbox: a 14 px box 5 px in; checked, a 12 px primary
       square with the mark. -->
  <Style Selector="CheckBox.ant">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border Name="Box" Width="14" Height="14" Margin="5,0,0,0"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  CornerRadius="3" BorderThickness="2" BorderBrush="{DynamicResource ButtonBorderBrush}" />
          <Border Name="Fill" Width="12" Height="12" Margin="6,0,0,0"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  CornerRadius="2" Background="{DynamicResource PrimaryBrush}" IsVisible="False">
            <Path Name="Check" Data="M 2.5,6 L 5,8.5 L 9.5,3" StrokeThickness="2"
                  Stroke="{DynamicResource CheckMarkBrush}" />
          </Border>
          <ContentPresenter Name="PART_ContentPresenter" Margin="24,0,0,0" VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="CheckBox.ant:checked /template/ Border#Fill">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="CheckBox.ant:checked /template/ Border#Box">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="CheckBox.ant:disabled">
    <Setter Property="Foreground" Value="{DynamicResource CheckDisabledBrush}" />
  </Style>
  <Style Selector="CheckBox.ant:disabled /template/ Border#Box">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Background" Value="{DynamicResource CheckDisabledFillBrush}" />
  </Style>
  <Style Selector="CheckBox.ant:disabled /template/ Border#Fill">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="CheckBox.ant:disabled /template/ Path#Check">
    <Setter Property="Stroke" Value="{DynamicResource CheckDisabledBrush}" />
  </Style>

  <!-- AntdUI.Select in forms: radius 6, the field border, 4 px wave
       margin like the inputs. -->
  <Style Selector="ComboBox.ant.field">
    <Setter Property="Padding" Value="11,0,0,0" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
  </Style>
  <Style Selector="ComboBox.ant.field /template/ Border#Background, ComboBox.ant.field:pointerover /template/ Border#Background">
    <Setter Property="Margin" Value="4" />
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
  </Style>
  <Style Selector="ComboBox.ant.field:focus-within /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource InputFocusShadow}" />
  </Style>
  <Style Selector="ComboBox.ant.field /template/ PathIcon#DropDownGlyph">
    <Setter Property="Margin" Value="0,0,14,0" />
  </Style>

  <!-- AntdUI.Label: grey while disabled. -->
  <Style Selector="TextBlock.ant:disabled">
    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
  </Style>

  <!-- AntdUI.Select of the drive list: 2 px border, radius 8. -->
  <Style Selector="ComboBox.ant">
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SelectBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox.ant:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource IconInactiveBrush}" />
  </Style>

  <!-- AntdUI.Panel of the main window panes: 1 px border, radius 6. -->
  <Style Selector="Border.pane">
    <Setter Property="Background" Value="{DynamicResource BackgroundPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <!-- ToolStrip grip: a dotted vertical line before each toolbar group. -->
  <Style Selector="Rectangle.grip">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeDashArray" Value="1,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,4,0" />
  </Style>
</Styles>
