<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Windows-only implementations behind the Core abstractions: the NTFS MFT,
		NtQueryDirectoryFile and FindFirstFileEx scanners, and the storage
		history details snapshot. Plain net10.0 (no Windows Desktop), marked as
		Windows-only. See ROADMAP.md, phase 2.
	-->

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<AssemblyName>c2flux.Platform.Windows</AssemblyName>
		<RootNamespace>c2flux</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<Authors>Daniel Capilla, Samuel Medeiros</Authors>
		<Company>Samuel Medeiros</Company>
		<Product>c² flux - Tree Scanner</Product>
		<Copyright>Copyright © Daniel Capilla, Samuel Medeiros</Copyright>

		<Version>2.0.0-beta.2</Version>
		<AssemblyVersion>2.0.0</AssemblyVersion>
		<FileVersion>2.0.0</FileVersion>
		<InformationalVersion>2.0.0-beta.2</InformationalVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
			<_Parameter1>windows</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\c2flux.Core\c2flux.Core.csproj" />
		<ProjectReference Include="..\..\libs\NtfsReader\NtfsReader.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="c2flux.App.Tests" />
	</ItemGroup>

</Project>
